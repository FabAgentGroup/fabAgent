---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	detect(detect)
	noise(noise)
	planner(planner)
	cause(cause)
	impact(impact)
	fast_impact(fast_impact)
	response(response)
	__end__([<p>__end__</p>]):::last
	__start__ --> detect;
	cause -. &nbsp;fast_track&nbsp; .-> fast_impact;
	cause -. &nbsp;proceed&nbsp; .-> impact;
	detect -.-> noise;
	detect -. &nbsp;go&nbsp; .-> planner;
	fast_impact --> response;
	impact --> response;
	planner --> cause;
	noise --> __end__;
	response --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
