# OpenAI API — 백엔드 멀티에이전트(agents/)용
# 서브에이전트 = GPT-5 mini, 오케스트레이터 = GPT-5
OPENAI_API_KEY=sk-...

# LangSmith Observability (선택, 비활성 시 트레이싱 off)
# LANGSMITH_TRACING=true 면 모든 LLM·tool·agent 호출이 LangSmith 대시보드로 전송됨
# https://smith.langchain.com 에서 API 키 발급
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=fabagent
